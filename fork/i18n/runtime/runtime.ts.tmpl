// Generated by the pt-BR overlay (fork/i18n). Do not edit: it is rebuilt on every build.
// Translates text that only exists at runtime (server error messages shown in
// toasts). Pure and isomorphic: unknown strings and non-strings pass through.

const MAP: Record<string, string> = JSON.parse(/*__PTBR_MAP__*/ "{}");

function translate(s: string): string {
  const hit = MAP[s];
  if (hit !== undefined) return hit;
  const trimmed = s.trim();
  if (trimmed && trimmed !== s) {
    const t = MAP[trimmed];
    if (t !== undefined) return s.replace(trimmed, t);
  }
  // "Prefix. Message" (getActionErrorMessage) -> translate both halves.
  const dot = s.indexOf(". ");
  if (dot > 0) {
    const a = s.slice(0, dot);
    const b = s.slice(dot + 2);
    const ta = MAP[a] ?? MAP[`${a}.`];
    const tb = MAP[b] ?? MAP[b.replace(/\.$/, "")];
    if (ta !== undefined || tb !== undefined) {
      return `${(ta ?? a).replace(/\.$/, "")}. ${tb ?? b}`;
    }
  }
  return s;
}

export function __ptbr<T>(value: T): T {
  return (typeof value === "string" ? translate(value) : value) as T;
}

const TOAST_METHODS = new Set(["success", "error", "info", "warning", "loading", "message"]);

function translateArgs(message: unknown, options: unknown): [unknown, unknown] {
  let opts = options;
  if (opts && typeof opts === "object" && typeof (opts as { description?: unknown }).description === "string") {
    const o = opts as { description: string };
    opts = { ...o, description: translate(o.description) };
  }
  return [__ptbr(message), opts];
}

/** Wraps sonner's `toast` so plain-string titles and descriptions are translated. */
export function __ptbrToast<T>(toastFn: T): T {
  const original = toastFn as unknown as ((m: unknown, o?: unknown) => unknown) & Record<string, unknown>;
  const wrapped = ((m: unknown, o?: unknown) => original(...translateArgs(m, o))) as typeof original;
  for (const key of Object.keys(original)) {
    const value = original[key];
    wrapped[key] =
      typeof value === "function" && TOAST_METHODS.has(key)
        ? (m: unknown, o?: unknown) => (value as (m: unknown, o?: unknown) => unknown)(...translateArgs(m, o))
        : value;
  }
  return wrapped as unknown as T;
}
